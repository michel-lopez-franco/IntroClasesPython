152204}, {\"x\": 9.195979899497488, \"y\": 0.22680707179394227}, {\"x\": 9.246231155778895, \"y\": 0.17759966814940648}, {\"x\": 9.296482412060302, \"y\": 0.12794388618470057}, {\"x\": 9.34673366834171, \"y\": 0.07796508973825698}, {\"x\": 9.396984924623116, \"y\": 0.027789458149423574}, {\"x\": 9.447236180904524, \"y\": -0.02245633230115589}, {\"x\": 9.49748743718593, \"y\": -0.07264542820573959}, {\"x\": 9.547738693467338, \"y\": -0.1226511192908991}, {\"x\": 9.597989949748744, \"y\": -0.1723471583175373}, {\"x\": 9.648241206030152, \"y\": -0.22160807981193165}, {\"x\": 9.698492462311558, \"y\": -0.2703095168230594}, {\"x\": 9.748743718592966, \"y\": -0.3183285149065574}, {\"x\": 9.798994974874372, \"y\": -0.3655438425425587}, {\"x\": 9.84924623115578, \"y\": -0.4118362972037624}, {\"x\": 9.899497487437186, \"y\": -0.4570890063009656}, {\"x\": 9.949748743718594, \"y\": -0.5011877222463261}, {\"x\": 10.0, \"y\": -0.5440211108893698}]}]}</script>\n```\n:::\n:::\n\n\nAhora graficamos esos datos con JavaScript, con un control que cambia la amplitud\ny la frecuencia **en el navegador**, sin volver a ejecutar Python:\n\n```{ojs}\nviewof amplitud   = Inputs.range([0.1, 3], {label: \"Amplitud\", step: 0.1, value: 1})\nviewof frecuencia = Inputs.range([0.5, 4], {label: \"Frecuencia\", step: 0.1, value: 1})\n```\n\n```{ojs}\nPlot.plot({\n  height: 300,\n  y: {domain: [-3, 3], grid: true},\n  marks: [\n    Plot.line(datos, {x: \"x\", y: d => amplitud * Math.sin(frecuencia * d.x),\n                      stroke: \"#2780e3\", strokeWidth: 2}),\n    Plot.line(datos, {x: \"x\", y: \"y\", stroke: \"#aaa\", strokeDasharray: \"4\"}),\n    Plot.ruleY([0])\n  ]\n})\n```\n\n::: {.callout-note}\nLa línea gris punteada es `sin(x)` calculada en Python; la azul se recalcula en\nJavaScript cada vez que mueves un control.\n:::\n\n## 4. Incluir un archivo HTML/JS externo\n\nPara código largo conviene tenerlo en un archivo aparte e incluirlo desde el YAML:\n\n```yaml\nformat:\n  html:\n    include-in-header: mis_estilos.html     # dentro de <head>\n    include-after-body: mi_script.html      # al final de <body>\n```\n\n",
